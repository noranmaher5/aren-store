NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/digivault

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRE=30d

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=DigiVault <noreply@digivault.com>

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal (server-side credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Supplier credentials (server-side only)
FOXRELOAD_API_KEY=
FOXRELOAD_BASE_URL=https://public-api.foxreload.com
FOXRELOAD_SANDBOX_ENABLED=false
FOXRELOAD_SANDBOX_BASE_URL=
FOXRELOAD_SANDBOX_API_KEY=
FAZERCARDS_API_KEY=
SUPPLIER_FULFILLMENT_ENABLED=false
SUPPLIER_REQUEST_TIMEOUT_MS=15000
FOXRELOAD_LANGUAGE=en
FOXRELOAD_CURRENCY=usd

# Frontend URL (for CORS & emails)
FRONTEND_URL=http://localhost:3000
USD_SAR_RATE=3.75
